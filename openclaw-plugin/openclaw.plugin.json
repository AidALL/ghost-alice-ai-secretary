{
  "id": "ai-secretary",
  "name": "AI Secretary",
  "version": "0.1.0",
  "description": "Local desktop secretary governed by Ghost-ALICE",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "secretary_status",
      "secretary_apps",
      "secretary_windows",
      "secretary_observe",
      "secretary_files",
      "secretary_draft",
      "secretary_act",
      "secretary_collect",
      "secretary_ingest",
      "secretary_artifacts"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "python": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "nativeBinary": {
        "type": "string"
      },
      "stateDir": {
        "type": "string"
      },
      "ghostRoot": {
        "type": "string"
      },
      "gaLedgerRoot": {
        "type": "string"
      },
      "node": {
        "type": "string"
      },
      "workerExecutable": {
        "type": "string"
      }
    },
    "required": [
      "source",
      "nativeBinary",
      "stateDir",
      "ghostRoot"
    ],
    "additionalProperties": false
  }
}
